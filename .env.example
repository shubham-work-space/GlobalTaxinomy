# Taxonomy Crosswalk 4.0 — local paths (relative to project root)

CHROMA_PERSIST_DIRECTORY=./data/chroma_db
EMBEDDING_STORE_DIRECTORY=./data/embeddings
GROUND_TRUTH_CSV=./Ground truth Onet to Esco/ONET_(Occupations)_0_updated.csv

CORS_ORIGINS=http://localhost:5173
API_PORT=8001

# Azure OpenAI embeddings (required for scripts/embed_isco_osca_facets.py)
AZURE_OAI_ENDPOINT=
AZURE_OAI_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OAI_EMBEDDING_DEPLOYMENT_LARGE=text-embedding-3-large

# TypeSafe System One / Jev (required for Eval runs with low-confidence Top-1)
# Docs: https://docs.typesafe.ai/api  →  POST {JEV_BASE_URL}/v1/systemone
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_CONCURRENCY=16

# Gated JEV enrichment (jev_context_v2) — raw O*NET 31.0 SQL + ESCO v1.2.1 CSV
# ONET_SQL_DIR=C:/Users/you/Downloads/db_31_0_mssql/db_31_0_mssql
# ESCO_CSV_DIR=C:/Users/you/Downloads/ESCO dataset - v1.2.1 - classification - en - csv
ONET_SQL_DIR=
ESCO_CSV_DIR=
